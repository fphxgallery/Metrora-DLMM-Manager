# ---- required --------------------------------------------------------------
# A real RPC endpoint. The public mainnet RPC will rate-limit this app instantly;
# use Helius/Triton/QuickNode or your own node.
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CLUSTER=mainnet-beta

# ---- safety ----------------------------------------------------------------
# Builds and simulates every transaction but sends nothing. Leave true until you
# have watched a full open -> rebalance -> exit cycle in the logs.
DRY_RUN=true
# Master switch for unattended rebalancing. Individual positions also opt in.
AUTO_REBALANCE=false

# ---- wallet ----------------------------------------------------------------
KEYPAIR_PATH=./secrets/keypair.json
# Allows creating/importing a key from the browser. Requires API_TOKEN to be set.
ENABLE_WALLET_UI=false
# Refuse to act below this SOL balance, so fees and rent stay payable.
MIN_SOL_BALANCE=0.05

# ---- position shape --------------------------------------------------------
# New positions span [activeBin - RANGE_BINS, activeBin + RANGE_BINS].
#
# IMPORTANT: this is a bin COUNT, and a bin's size is the POOL's bin step, so the
# same number is a different price band on every pool:
#   price band ~= +/-((1 + binStep/10000)^RANGE_BINS - 1)
#   binStep 1 -> +/-0.6%   binStep 4 -> +/-2.4%   binStep 20 -> +/-12.7%   binStep 80 -> +/-61%
# The default targets a bin-step-4 major pair (e.g. SOL-USDC), whose median daily
# high-low is around 3%. Set it per pool from the price band you actually want —
# the pool detail view prints the band the current value produces.
RANGE_BINS=60
# Spot | Curve | BidAsk
STRATEGY_TYPE=Spot

# ---- rebalance triggers ----------------------------------------------------
POLL_INTERVAL_MS=30000
# Fire once the active bin is within this many bins of a range edge.
# Must be < RANGE_BINS. ~20% of RANGE_BINS is a reasonable starting point.
EDGE_BUFFER_BINS=12
# Never rebalance the same position more often than this. The main anti-churn knob.
COOLDOWN_MIN=60
# Skip the rebalance unless accrued fees cover this multiple of its estimated cost.
MIN_FEE_COVER_RATIO=1.5

# ---- rebalance execution ---------------------------------------------------
# Token-ratio drift (bps of position value) that justifies adding a swap leg.
# The swap path costs roughly 30x an atomic rebalance, so tolerate a fairly
# lopsided position before paying for one.
RATIO_TOLERANCE_BPS=3000
# Hard ceiling on how much of a position's value one rebalance may swap.
MAX_SWAP_PCT_OF_POSITION=50

# Refuse the swap leg when Jupiter's quoted price impact exceeds this (bps).
# A ceiling on how bad a route we will take -- distinct from SWAP_SLIPPAGE_BPS,
# which is tolerance for movement on a route already accepted. 200 = 2%, the
# default in Meteora's own swap settings. The withdrawn funds stay in the wallet
# and the journal entry retries on a later tick, when impact may be lower.
MAX_SWAP_PRICE_IMPACT_BPS=200
# Slippage tolerance for the ratio swap, in bps. 50 = 0.5%, Meteora's own fixed
# swap default. Do NOT set 0 on a low-volatility pair: 0 hands the choice to
# Jupiter's dynamic slippage, whose maxBps is a ceiling and not a floor, and it
# picked 15bps every time on SOL/USDC -- about one swap in five then died on
# error 6001 because price moved between quote and landing.
SWAP_SLIPPAGE_BPS=50

# Hard ceiling in LAMPORTS on the priority fee Jupiter may attach to one swap.
# Jupiter builds and signs the swap itself, so PRIORITY_FEE_MICROLAMPORTS (a
# per-CU price for transactions WE build) does not apply to it -- this is the
# only control over that leg. 200000 = ~0.0002 SOL, generous next to observed
# swap fees of 16k-75k lamports. Rejected above 100000000 (0.1 SOL).
MAX_SWAP_PRIORITY_LAMPORTS=200000
# Bins the active bin may move between simulation and landing before the ix fails.
# Also bin-step-dependent: 15 bins is 0.6% at bin step 4, but 12% at bin step 80.
# Too tight and rebalances fail on volatile pairs; too loose and you re-centre
# around a price that already moved.
MAX_ACTIVE_BIN_SLIPPAGE=15

# ---- wallet buffer ---------------------------------------------------------
# The rebalance instruction settles rounding shortfalls out of the wallet's ATA:
# with STRATEGY_TYPE=Curve the redeposit side can ask for marginally more of a token
# than the withdraw released, and against an EMPTY ATA that becomes an SPL Token
# "insufficient funds" (0x1) at simulation -- failing the whole rebalance before its
# first transaction is sent. The shortfall is cents; a dollar left idle covers it.
MIN_QUOTE_BALANCE_USD=1
# Swap a little SOL into the quote token when the buffer runs dry. Set false to be
# warned (log + telegram) and top it up yourself.
AUTO_TOPUP=true
# Hard ceiling on a single top-up, so a mispriced quote cannot drain the wallet.
# Must be >= MIN_QUOTE_BALANCE_USD. MIN_SOL_BALANCE is never spent to fund one.
MAX_TOPUP_USD=5

# ---- stop loss / take profit -----------------------------------------------
# These are DEFAULTS, not switches. No position is armed until you turn triggers
# on for it individually in POSITIONS -- firing closes the position and there is
# no undo, since reopening pays bin-array rent that is never recoverable.
#
# false still evaluates every threshold and still alerts over Telegram; it just
# never acts. Run new numbers this way for a week before arming them. DRY_RUN
# behaves the same, because a simulated close cannot exercise the swap that
# follows it and would prove nothing.
TRIGGERS_ARMED=false
# pct = PnL % change, usd = PnL in dollars. Either way it is the INDEXER's PnL,
# which includes impermanent loss -- not "fees earned went negative".
TRIGGER_MEASURE=pct
# Blank disables. STOP_LOSS must be negative, TAKE_PROFIT positive.
# STOP_LOSS=-15
# TAKE_PROFIT=40
# Consecutive readings past a threshold before anything closes; one reading back
# inside resets the count to zero. Do not set this to 1: on 2026-07-30 the Data
# API reported -$43.56 for ten seconds on a position actually up $1.32, having
# indexed a rebalance's withdraw leg and not its deposit.
TRIGGER_CONFIRMATIONS=3
TRIGGER_CHECK_MIN=2
# zap-y (consolidate into the quote side), zap-x (the base side), or exit (close
# and keep both tokens).
TRIGGER_ON_FIRE=zap-y
# A position the indexer has not priced yet must not trip a stop at birth.
TRIGGER_MIN_AGE_MIN=30

# ---- pnl history -----------------------------------------------------------
# The Data API reports only a position's CURRENT value -- there is no historical
# endpoint -- so the METRICS charts are drawn from samples this app writes itself,
# to data/samples.jsonl. A window that was never sampled can never be backfilled:
# after a fresh start the 24h chart fills within a day, 7d within a week, and the
# longer views stay locked until that much history exists.
# 15 minutes = 96 readings/day, ~8,600 rows per position at 90-day retention.
SAMPLE_INTERVAL_MIN=15
SAMPLE_RETENTION_DAYS=90
# Per-CU price, in micro-lamports, for transactions WE build. Sampled on mainnet,
# 141 of 150 recent blocks paid ZERO, so 50000 is already well above market. Only
# safe this low because sends rebroadcast until the blockhash expires. Back off to
# 100000 if you see active-bin-slippage failures or rebroadcast counts above 15.
PRIORITY_FEE_MICROLAMPORTS=50000
COMPUTE_UNIT_LIMIT=600000

# ---- service ---------------------------------------------------------------
PORT=8080
# 127.0.0.1 for a local install; docker-compose overrides this to 0.0.0.0 inside
# the container (the published port is the real boundary).
HOST=127.0.0.1
# Bearer token for every mutating endpoint, and the dashboard login. Leave unset
# ONLY on loopback. Required before the wallet UI can be enabled.
# API_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info

# ---- meteora data api ------------------------------------------------------
DATA_API_URL=https://dlmm.datapi.meteora.ag
DATA_API_CACHE_MS=10000

# ---- alerts (optional) -----------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
