# ---- required --------------------------------------------------------------
# A real RPC endpoint. The public mainnet RPC will rate-limit this app instantly;
# use Helius/Triton/QuickNode or your own node.
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
CLUSTER=mainnet-beta

# ---- safety ----------------------------------------------------------------
# Builds and simulates every transaction but sends nothing. Leave true until you
# have watched a full open -> rebalance -> exit cycle in the logs.
DRY_RUN=true
# Master switch for unattended rebalancing. Individual positions also opt in.
AUTO_REBALANCE=false

# ---- wallet ----------------------------------------------------------------
KEYPAIR_PATH=./secrets/keypair.json
# Allows creating/importing a key from the browser. Requires API_TOKEN to be set.
ENABLE_WALLET_UI=false
# Refuse to act below this SOL balance, so fees and rent stay payable.
MIN_SOL_BALANCE=0.05

# ---- position shape --------------------------------------------------------
# New positions span [activeBin - RANGE_BINS, activeBin + RANGE_BINS].
RANGE_BINS=20
# Spot | Curve | BidAsk
STRATEGY_TYPE=Spot

# ---- rebalance triggers ----------------------------------------------------
POLL_INTERVAL_MS=30000
# Fire once the active bin is within this many bins of a range edge.
# Must be < RANGE_BINS.
EDGE_BUFFER_BINS=2
# Never rebalance the same position more often than this. The main anti-churn knob.
COOLDOWN_MIN=15
# Skip the rebalance unless accrued fees cover this multiple of its estimated cost.
MIN_FEE_COVER_RATIO=1.5

# ---- rebalance execution ---------------------------------------------------
# Token-ratio drift (bps of position value) that justifies adding a swap leg.
RATIO_TOLERANCE_BPS=1500
# Hard ceiling on how much of a position's value one rebalance may swap.
MAX_SWAP_PCT_OF_POSITION=60
# 0 = let Jupiter pick (dynamic slippage).
SWAP_SLIPPAGE_BPS=0
# Bins the active bin may move between simulation and landing before the ix fails.
MAX_ACTIVE_BIN_SLIPPAGE=5
PRIORITY_FEE_MICROLAMPORTS=200000
COMPUTE_UNIT_LIMIT=600000

# ---- service ---------------------------------------------------------------
PORT=8080
# 127.0.0.1 for a local install; docker-compose overrides this to 0.0.0.0 inside
# the container (the published port is the real boundary).
HOST=127.0.0.1
# Bearer token for every mutating endpoint, and the dashboard login. Leave unset
# ONLY on loopback. Required before the wallet UI can be enabled.
# API_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info

# ---- meteora data api ------------------------------------------------------
DATA_API_URL=https://dlmm.datapi.meteora.ag
DATA_API_CACHE_MS=10000

# ---- alerts (optional) -----------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
